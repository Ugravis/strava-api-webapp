# Public entry point: HTTPS certificates (Let's Encrypt) and redirection from
# http, then everything goes to Next.js, which proxies /api to the backend.
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy frontend:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Back office on its own subdomain (`ADMIN_DOMAIN`): host-only cookies, never
# indexed. The admin app only proxies /api/admin to the backend.
{$ADMIN_DOMAIN:admin.localhost} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Robots-Tag "noindex, nofollow, noarchive"
		-Server
	}
	reverse_proxy admin:3000
}
