# Copy to .env (`cp .env.example .env`). The defaults below work as is with
# `docker compose up`: the only values worth filling in are the Google and
# Strava pairs.
# Inside Docker, hosts and ports of the services are overridden by
# docker-compose.yml; the localhost values here serve the commands run from
# your machine (pnpm dev:*, pnpm db:reset, migrations).

# --- Database (PostgreSQL + PostGIS) ---------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=strava_webapp

# --- Backend ---------------------------------------------------------------
PORT=4000
# Public URL of the frontend: used in email links, redirects and CORS/CSRF checks.
FRONTEND_URL=http://localhost:3000
# Signs the short-lived Google sign-in cookies. Any value works in development;
# use a long random string in production (`openssl rand -base64 32`).
COOKIE_SECRET=development-cookie-secret
# Encrypts the third-party OAuth tokens stored in the database (Strava).
# Any value works in development; use a long random string in production.
# Changing it invalidates the stored tokens: users must reconnect Strava.
ENCRYPTION_SECRET=development-encryption-secret

# --- Google sign-in (optional) ---------------------------------------------
# Leave empty to keep the button visible but disabled on the API side: a click
# then brings the user back to the login page with a notice.
# To get these values: Google Cloud console > APIs & Services > Credentials >
# Create credentials > OAuth client ID > "Web application", then add
#   Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# (the first time, the OAuth consent screen must be configured: "External",
# and your own Google account added as a test user).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Strava (activity import) -------------------------------------------------
# Leave empty to disable the Strava connection (the button explains it is
# unavailable). To get these values: https://www.strava.com/settings/api >
# create an application (requires a Strava subscription since June 2026) with
#   Authorization Callback Domain: localhost
# A new application only accepts its owner's account (athlete capacity 1).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Most recent activities imported by the first synchronization. Leave empty
# to import the whole history (mind the API quotas).
STRAVA_SYNC_MAX_ACTIVITIES=50
# Webhooks need a public URL. Development: `docker compose --profile tunnel up`
# finds it automatically. Production: the public URL of /api/strava/webhook.
STRAVA_WEBHOOK_CALLBACK_URL=
# Secret Strava echoes when it validates the webhook subscription.
STRAVA_WEBHOOK_VERIFY_TOKEN=development-webhook-verify-token

# --- Email (password reset links) -------------------------------------------
# Development: Mailpit catches every email, inbox at http://localhost:8025.
# Production: point to a real SMTP provider (and set SMTP_USER / SMTP_PASSWORD).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=Strava Webapp <no-reply@localhost>

# --- Object storage for avatars (S3-compatible) -----------------------------
# Development: RustFS (S3 API on :9000, console on http://localhost:9001); the
# bucket is created automatically. Production: any S3-compatible service.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=strava-webapp
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin

# --- Frontend ---------------------------------------------------------------
# Server-side URL of the API (the browser reaches it through the /api rewrite).
API_INTERNAL_URL=http://localhost:4000

# --- Optional port overrides -------------------------------------------------
ADMINER_PORT=8088
# MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025
# S3_PORT=9000
# S3_CONSOLE_PORT=9001
