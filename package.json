{
  "name": "strava-api-webapp",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:backend": "pnpm --filter backend start:dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:backend": "pnpm --filter backend check",
    "check:frontend": "pnpm --filter frontend check",
    "check:shared": "pnpm --filter @strava-webapp/shared check",
    "check-all": "pnpm -r --workspace-concurrency=1 check"
  }
}
