# Production settings, read by docker-compose.prod.yml. Copy to `.env` on the
# server (`chmod 600 .env`). The backend refuses to start with a missing
# secret or a development default.
# Generate each secret separately: `openssl rand -hex 32`.

# --- Public address -----------------------------------------------------------
# Public URL, port included when it is not 443 (https://example.com:8443).
FRONTEND_URL=https://example.com
# Port of the frontend on the server loopback, for the host web server.
FRONTEND_PORT=3100
# Only with the bundled Caddy (`--profile caddy`): domain it serves.
DOMAIN=

# --- Back office ----------------------------------------------------------------
# Public URL of the back office, on its own subdomain (https://admin.example.com).
ADMIN_URL=
# Port of the back office on the server loopback, for the host web server.
ADMIN_PORT=3200
# Only with the bundled Caddy: subdomain of the back office.
ADMIN_DOMAIN=

# --- Secrets ------------------------------------------------------------------
COOKIE_SECRET=
# Changing it invalidates the stored Strava tokens: users must reconnect.
ENCRYPTION_SECRET=
# Also the last segment of the webhook URL: letters, digits, "-" and "_" only.
STRAVA_WEBHOOK_VERIFY_TOKEN=

# --- Database -----------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=
DB_NAME=strava_webapp
# Port of the database on the server loopback (SSH tunnels, backups).
DB_HOST_PORT=5432

# --- Object storage (avatars) -------------------------------------------------
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=kilotrace

# --- Email --------------------------------------------------------------------
# Sign-up, sign-in and password reset by email. Off for now: Google only.
# Turning them on requires the SMTP settings below.
EMAIL_SIGN_IN_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=Kilotrace <no-reply@example.com>

# --- Google sign-in -----------------------------------------------------------
# Authorized redirect URI: https://example.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Strava -------------------------------------------------------------------
# Authorization Callback Domain: example.com
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_SYNC_MAX_ACTIVITIES=
