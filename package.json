{
  "name": "kilotrace",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run lint typecheck test test:e2e build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "db:reset": "pnpm --filter @kilotrace/backend db:reset",
    "db:seed:bench": "pnpm --filter @kilotrace/backend db:seed:bench",
    "countries:import": "pnpm --filter @kilotrace/backend countries:import",
    "stations:import": "pnpm --filter @kilotrace/backend stations:import"
  },
  "devDependencies": {
    "turbo": "2.11.8"
  }
}
