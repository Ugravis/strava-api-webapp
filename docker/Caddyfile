# Public entry point: HTTPS certificates (Let's Encrypt) and redirection from
# http, then everything goes to Next.js, which proxies /api to the backend.
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy frontend:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
