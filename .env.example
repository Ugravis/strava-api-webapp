# Database (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=strava_webapp

# Backend
PORT=4000
FRONTEND_URL=http://localhost:3000
# Signs the short-lived OAuth cookies. Use a long random value outside development.
COOKIE_SECRET=development-cookie-secret

# Google sign-in (optional: the button is hidden when unset)
# Authorized redirect URI: ${FRONTEND_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Mailpit in development: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=Strava Webapp <no-reply@localhost>

# Object storage (S3-compatible, RustFS in development: http://localhost:9001)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=strava-webapp
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin

# Frontend (server side only: the browser reaches the API through the /api rewrite)
API_INTERNAL_URL=http://localhost:4000
