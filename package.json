{
  "name": "kilotrace",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:backend": "pnpm --filter @kilotrace/backend start:dev",
    "dev:frontend": "pnpm --filter @kilotrace/frontend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:backend": "pnpm --filter @kilotrace/backend check",
    "check:frontend": "pnpm --filter @kilotrace/frontend check",
    "check:shared": "pnpm --filter @kilotrace/shared check",
    "check-all": "pnpm -r --workspace-concurrency=1 check",
    "db:reset": "pnpm --filter @kilotrace/backend db:reset",
    "db:seed:bench": "pnpm --filter @kilotrace/backend db:seed:bench",
    "countries:import": "pnpm --filter @kilotrace/backend countries:import",
    "stations:import": "pnpm --filter @kilotrace/backend stations:import"
  }
}
